# Database (using in-memory for development)
DATABASE_URL=postgresql://postgres:password@localhost:5432/performix_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=performix_dev
DB_USER=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=dev-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_51234567890abcdef
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/
